# ==============================================================================
# Dockerfile for RetailLake 360 Analytics Dashboard (Streamlit + MySQL 8.4)
# ==============================================================================
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies (MySQL 8.4 client)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    default-mysql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install dependencies (strictly MySQL / PyMySQL / Streamlit)
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code and config
COPY config/ /app/config/
COPY src/ /app/src/

EXPOSE 8501

HEALTHCHECK CMD curl --fail http://localhost:8501/_stcore/health || exit 1

ENTRYPOINT ["streamlit", "run", "src/dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
