# Copy to .env and set each blank password to a unique, strong value.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=

MYSQL_SOURCE_DB=retaillake_source
MYSQL_SERVING_DB=retaillake_serving
MYSQL_METADATA_DB=retaillake_metadata

MYSQL_SOURCE_USER=source_user
MYSQL_SOURCE_PASSWORD=

MYSQL_PIPELINE_USER=pipeline_user
MYSQL_PIPELINE_PASSWORD=

MYSQL_ANALYTICS_USER=analytics_user
MYSQL_ANALYTICS_PASSWORD=

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SEC=1800
DB_POOL_TIMEOUT_SEC=30
DB_POOL_PRE_PING=True

LAKEHOUSE_STORAGE_BASE=./lakehouse
LAKEHOUSE_BRONZE_DIR=./lakehouse/bronze
LAKEHOUSE_SILVER_DIR=./lakehouse/silver
LAKEHOUSE_GOLD_DIR=./lakehouse/gold

SPARK_APP_NAME="RetailLake360-DeltaEngine"
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g

STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

AIRFLOW_IMAGE_NAME=apache/airflow:2.8.1-python3.10
AIRFLOW_UID=50000
AIRFLOW_USER=airflow_admin
AIRFLOW_PASSWORD=
