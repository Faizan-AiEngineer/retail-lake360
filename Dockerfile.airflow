# ==============================================================================
# Dockerfile for RetailLake 360 Airflow orchestration
# Configured with MySQL 8.4 Client and PyMySQL Drivers (MySQL 8.4 LTS Architecture)
# ==============================================================================
FROM apache/airflow:2.8.1-python3.10

USER root

# Install curl, the default MySQL client, and OpenJDK 17 for the Spark session helper
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jre-headless \
    default-mysql-client \
    curl \
    procps \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

USER airflow

# Install Python requirements
COPY --chown=airflow:root requirements.txt /requirements.txt
RUN pip install --no-cache-dir -r /requirements.txt

# Create app directory for Lakehouse data and code
WORKDIR /app
