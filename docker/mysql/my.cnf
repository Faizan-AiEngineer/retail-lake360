[mysqld]
# ==============================================================================
# MySQL 8.4 LTS Enterprise Configuration for RetailLake 360
# Optimized for Lakehouse Serving, OLTP Simulation & Metadata Tracking
# ==============================================================================

# Server Identification & Networking
server-id = 1
bind-address = 0.0.0.0
port = 3306
mysqlx = 0

# Character Sets
character-set-server = utf8mb4
collation-server = utf8mb4_0900_ai_ci

# Memory & Buffer Pool Tuning
innodb_buffer_pool_size = 512M
innodb_log_file_size = 128M
innodb_flush_log_at_trx_commit = 2
innodb_flush_method = O_DIRECT
innodb_file_per_table = 1
innodb_stats_on_metadata = 0

# Connections & Threads
max_connections = 250
max_connect_errors = 10000
wait_timeout = 28800
interactive_timeout = 28800
thread_cache_size = 16

# Temp Tables & Query Processing
tmp_table_size = 64M
max_heap_table_size = 64M
sort_buffer_size = 4M
join_buffer_size = 4M

# Logging & Performance Diagnostics
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 1.0
log_queries_not_using_indexes = 0

# SQL Mode Configuration (Strict ACID Compliance)
sql_mode = "STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION,ONLY_FULL_GROUP_BY"
